button(type="button", class="btn btn-secondary", onclick="reduce()") Press Me
div(id="use") take some away

script.
  let current = 11;
  let quantity = 2;
  function reduce() {
    current -= quantity;
    if (current < 0) current = 0;
    document.getElementById("use").innerText = `Reduced by ${quantity} to ${current}`;
  }